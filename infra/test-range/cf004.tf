# CF-004: published tunnel hostname reachable without Access.
#
# Seeded (cf004-seeded): a public hostname in the remotely managed ingress of
# a tunnel, with an SSH origin and no Access app. The evaluator decides it
# `public`, and the non-HTTP origin makes the hit critical.
#
# Clean (cf004-clean): a second hostname of the same tunnel with the same
# kind of origin, behind an Access app with an Allow policy for one address,
# the fix in rules/CF-004/fix/.
#
# Safety:
# - No connector runs for this tunnel, and none may be started: no cloudflared
#   process holds its token. A request to the seeded hostname ends at
#   Cloudflare's edge with a tunnel error; the clean one asks for a sign-in
#   first.
# - Both origins point to no-origin.invalid, a name that never resolves, so
#   even a connector started by mistake reaches no SSH server.
# - The tunnel secret is generated by Cloudflare and never set or output
#   here.

locals {
  cf004_seeded_host = "${local.p}-cf004-seeded.${var.zone_name}"
  cf004_clean_host  = "${local.p}-cf004-clean.${var.zone_name}"
  cf004_origin      = "ssh://${local.no_origin}:22"
}

resource "cloudflare_zero_trust_tunnel_cloudflared" "cf004" {
  account_id = var.account_id
  name       = "${local.p}-cf004"
  config_src = "cloudflare"
}

resource "cloudflare_zero_trust_tunnel_cloudflared_config" "cf004" {
  account_id = var.account_id
  tunnel_id  = cloudflare_zero_trust_tunnel_cloudflared.cf004.id

  config = {
    ingress = [
      { hostname = local.cf004_seeded_host, service = local.cf004_origin },
      { hostname = local.cf004_clean_host, service = local.cf004_origin },
      # The final rule answers with a status code; the collector emits no node for it.
      { service = "http_status:404" },
    ]
  }

  # Access first, so the clean hostname is never published without it.
  depends_on = [cloudflare_zero_trust_access_application.cf004_clean]
}

resource "cloudflare_zero_trust_access_application" "cf004_clean" {
  account_id   = var.account_id
  name         = local.cf004_clean_host
  type         = "self_hosted"
  domain       = local.cf004_clean_host
  destinations = [{ type = "public", uri = local.cf004_clean_host }]
  policies     = [{ id = cloudflare_zero_trust_access_policy.allow_named_email.id, precedence = 1 }]
}

# The DNS records publish the hostnames as the dashboard would. They point to
# the tunnel, which has no connector.

resource "cloudflare_dns_record" "cf004_seeded" {
  zone_id = var.zone_id
  name    = local.cf004_seeded_host
  type    = "CNAME"
  content = "${cloudflare_zero_trust_tunnel_cloudflared.cf004.id}.cfargotunnel.com"
  proxied = true
  ttl     = 1
  comment = "Virga test range: CF-004 seeded case"
}

resource "cloudflare_dns_record" "cf004_clean" {
  zone_id = var.zone_id
  name    = local.cf004_clean_host
  type    = "CNAME"
  content = "${cloudflare_zero_trust_tunnel_cloudflared.cf004.id}.cfargotunnel.com"
  proxied = true
  ttl     = 1
  comment = "Virga test range: CF-004 clean counterpart"

  depends_on = [cloudflare_zero_trust_access_application.cf004_clean]
}

{
  "name": "virga",
  "private": true,
  "description": "Agentless, read-only security graph for Cloudflare accounts",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "rules:build": "node packages/rules/src/cli.ts build",
    "rules:check": "node packages/rules/src/cli.ts check",
    "ci": "pnpm lint && pnpm rules:check && pnpm typecheck && pnpm test && pnpm test:scripts",
    "build": "pnpm -r --if-present build",
    "deploy": "node scripts/deploy.ts",
    "deploy:dry-run": "node scripts/deploy.ts --dry-run",
    "test:scripts": "tsc -p scripts && vitest run --root scripts",
    "check:release-age": "node scripts/check-release-age.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "virga-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The core Worker holds no routes and is reachable only through service
  // bindings (docs/implementation-plan.md, deployment topology).
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_GRAPH", "class_name": "AccountGraph" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountGraph"] }],
  "workflows": [
    {
      // One instance per account and scan, created by the dispatcher or Admin.
      "name": "virga-scan",
      "binding": "SCAN_WORKFLOW",
      "class_name": "ScanWorkflow",
      // Scan history lives in the graph; Workflow state is kept short.
      "default_retention": { "success_retention": "3 days", "error_retention": "7 days" }
    },
    {
      // Hourly (UTC) at minute 17; starts the scans of accounts that are due.
      "name": "virga-dispatch",
      "binding": "DISPATCH_WORKFLOW",
      "class_name": "DispatchWorkflow",
      "schedules": ["17 * * * *"],
      "default_retention": { "success_retention": "1 day", "error_retention": "7 days" }
    }
  ],
  // The account index. Separate from the broker's vault (D-08).
  // database_id is left out so that `wrangler deploy` provisions it.
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_name": "virga-index",
      "migrations_dir": "migrations"
    }
  ],
  // Read calls to the Cloudflare API go only through the broker.
  "services": [{ "binding": "BROKER", "service": "virga-broker", "entrypoint": "ApiCaller" }]
}
